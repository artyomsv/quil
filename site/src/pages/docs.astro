---
/**
 * /docs/ — the field manual. It answers "what am I trying to do?" and routes
 * to the exact section of the docs on GitHub; it copies none of them. Every
 * entry is server-rendered; the filter is progressive enhancement.
 */
import Page from "@/layouts/Page.astro";
import ManualEntry from "@/components/docs/ManualEntry.astro";
import { manual, shelf } from "@/data/docs";
import { GITHUB_BLOB, canonical } from "@/data/seo";
import { breadcrumbSchema, itemListSchema } from "@/data/schemas";

const seo = {
  title: "Docs: use cases, keys and the GitHub docs",
  description:
    "A field manual for Quil: thirteen ways to use it, the keys for each, and the exact section of the documentation on GitHub that explains it.",
  path: "/docs/",
  ogImage: "/og/docs.png",
  keywords: ["quil documentation", "quil docs", "quil keybindings", "quil mcp", "terminal multiplexer docs"],
};
const schemas = [
  breadcrumbSchema([{ name: "Quil", path: "/" }, { name: "Docs", path: "/docs/" }]),
  itemListSchema({
    name: "Quil documentation",
    description: "The main documents in the Quil repository.",
    url: canonical("/docs/"),
    items: shelf.map((s) => ({ name: s.file, description: s.what, url: GITHUB_BLOB + s.file })),
  }),
];
const tour = manual.filter((e) => e.tour);
const more = manual.filter((e) => !e.tour);
---
<Page {...seo} schemas={schemas}>
  <section class="hero">
    <div class="wrap">
      <div class="crumb">QUIL / <b>DOCS</b> · THE DOCS LIVE ON GITHUB, THIS PAGE ROUTES TO THEM</div>
      <h1>What are you trying to do?</h1>
      <p>Each row is one way to use Quil: the steps, the keys, and the exact section of the docs that explains it. The first six are the stops of the <a href="/">tour on the home page</a>.</p>
      <div class="tools">
        <label class="filter" for="q"><span class="g">&gt;</span><input id="q" type="search" placeholder="filter: worktree, docker, resume, ssh…" autocomplete="off" spellcheck="false" /><kbd>/</kbd></label>
        <div class="start">new here?
          <a href={`${GITHUB_BLOB}docs/installation.md`} rel="noopener">install</a>
          <a href={`${GITHUB_BLOB}docs/quick-start.md`} rel="noopener">quick start</a>
          <a href={`${GITHUB_BLOB}docs/keybindings.md`} rel="noopener">keys</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap layout">
    <nav class="tree" aria-label="Use cases">
      <div class="h">TOUR</div>
      <ul>{tour.map((e) => <li data-id={e.id}><a href={`#${e.id}`}><span class="g">○</span>{e.persona.toLowerCase()}</a></li>)}</ul>
      <div class="h">MORE</div>
      <ul>{more.map((e) => <li data-id={e.id}><a href={`#${e.id}`}><span class="g">○</span>{e.persona.toLowerCase()}</a></li>)}</ul>
      <div class="h">SHELF</div>
      <ul><li><a href="#shelf"><span class="g">○</span>{shelf.length} docs on github</a></li></ul>
    </nav>
    <div>
      <div class="group">IN THE TOUR · <b>{tour.length}</b></div>
      {tour.map((e, i) => <ManualEntry e={e} n={i + 1} />)}
      <div class="group more-group">MORE WAYS TO USE IT · <b>{more.length}</b></div>
      {more.map((e, i) => <ManualEntry e={e} n={tour.length + i + 1} />)}
      <div class="empty" id="empty" hidden>No use case matches. Try the shelf below.</div>
    </div>
  </div>

  <section class="shelf" id="shelf">
    <div class="wrap">
      <h2>The shelf</h2>
      <p>The main documents in the repository, in plain Markdown.</p>
      <div class="books">
        {shelf.map((b) => <a href={GITHUB_BLOB + b.file} rel="noopener"><span class="p">{b.file}</span><span class="w">{b.what}</span><span class="ar">↗</span></a>)}
      </div>
    </div>
  </section>
</Page>

<script>
  const q = document.getElementById("q");
  const empty = document.getElementById("empty");
  const entries = [...document.querySelectorAll<HTMLElement>(".entry")];
  if (q instanceof HTMLInputElement && empty) {
    const filter = () => {
      const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const el of entries) {
        const hit = words.every((w) => (el.dataset.text ?? "").includes(w));
        el.hidden = !hit;
        if (hit) shown++;
        document.querySelector(`.tree li[data-id="${el.id}"]`)?.classList.toggle("hide", !hit);
      }
      empty.hidden = shown > 0;
    };
    q.addEventListener("input", filter);
    addEventListener("keydown", (e) => {
      const t = e.target;
      const typing = t instanceof HTMLElement && (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable);
      if (e.key === "/" && !typing) { e.preventDefault(); q.focus(); }
      if (e.key === "Escape" && document.activeElement === q) { q.value = ""; filter(); q.blur(); }
    });
  }
  // The tree marks the entry in view, like Quil's sidebar marks the active pane.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".tree a[href^='#']")].map((a) => [a.getAttribute("href")!.slice(1), a]));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((xs) => {
      for (const x of xs) {
        if (!x.isIntersecting) continue;
        links.forEach((a) => { a.classList.remove("on"); a.querySelector(".g")!.textContent = "○"; });
        const a = links.get(x.target.id);
        if (a) { a.classList.add("on"); a.querySelector(".g")!.textContent = "▸"; }
      }
    }, { rootMargin: "-30% 0px -60% 0px" });
    entries.forEach((el) => io.observe(el));
  }
</script>

<style>
  .hero { padding-block: 52px 30px; border-bottom: 1px solid var(--t-line); }
  .crumb { font: 11px var(--mono); letter-spacing: .14em; color: var(--t-dim); }
  .crumb b { color: var(--t-hint); font-weight: 700; }
  h1 { margin: 14px 0 0; font: 800 clamp(32px, 4.8vw, 56px)/1.02 var(--mono); letter-spacing: -0.03em; color: var(--t-title); }
  .hero p { margin: 14px 0 0; max-width: 64ch; color: var(--t-soft); font-size: 16.5px; line-height: 1.6; }
  .hero p a { color: var(--t-hint); text-decoration: underline; text-underline-offset: 3px; }
  .tools { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center; }
  .filter { display: flex; align-items: center; gap: 10px; flex: 1 1 360px; max-width: 560px; padding: 9px 14px; border: 1px solid var(--t-dialog); border-radius: 6px; background: var(--t-bg); font: 14px var(--mono); }
  .filter:focus-within { box-shadow: 0 0 0 3px #5f5fff33; }
  .filter .g { color: var(--t-title); font-weight: 700; }
  .filter input { all: unset; flex: 1; min-width: 0; color: var(--t-title); }
  .filter input::placeholder { color: var(--t-sub); }
  .filter kbd { font: 11px var(--mono); color: var(--t-soft); background: var(--t-line-2); padding: 1px 6px; }
  .start { display: flex; flex-wrap: wrap; gap: 6px 14px; font: 13px var(--mono); color: var(--t-dim); }
  .start a { color: var(--t-title); background: var(--t-line-2); padding: 1px 1ch; }
  .start a:hover { background: var(--t-violet); }
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 44px; padding-block: 30px 40px; }
  .tree { position: sticky; top: calc(var(--hh) + 22px); align-self: start; font: 13px/1.72 var(--mono); white-space: nowrap; max-height: calc(100vh - var(--hh) - 44px); overflow-y: auto; overflow-x: hidden; }
  .tree .h { color: var(--t-mute); font-weight: 700; margin-top: 12px; }
  .tree .h:first-child { margin-top: 0; }
  .tree ul { list-style: none; margin: 0; padding: 0; }
  .tree a { display: block; color: var(--t-soft); overflow: hidden; text-overflow: ellipsis; }
  .tree a .g { display: inline-block; width: 2ch; color: var(--t-dim); }
  .tree a:hover { color: var(--t-title); }
  .tree a.on { color: var(--t-title); font-weight: 700; }
  .tree a.on .g { color: var(--t-blue); }
  .tree li.hide { display: none; }
  .group { font: 700 12px var(--mono); letter-spacing: .18em; color: var(--t-mute); padding: 6px 0 12px; }
  .group b { color: var(--t-hint); }
  .more-group { margin-top: 30px; }
  .empty { padding: 40px 0; font: 14px var(--mono); color: var(--t-dim); border-top: 1px solid var(--t-line); }
  .shelf { padding-block: 30px 40px; border-top: 1px solid var(--t-line); }
  .shelf h2 { margin: 0; font: 800 clamp(22px, 2.8vw, 32px)/1.1 var(--mono); color: var(--t-title); }
  .shelf p { margin: 8px 0 0; color: var(--t-dim); font-size: 15px; }
  .books { margin-top: 22px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; }
  .books a { display: grid; grid-template-columns: minmax(0, 15em) minmax(0, 1fr) auto; gap: 14px; align-items: baseline; padding: 10px 2px; border-bottom: 1px solid var(--t-line); font: 13px var(--mono); }
  .books .p { color: var(--t-title); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .books .w { color: var(--t-mute); font-family: var(--sans); font-size: 14px; }
  .books .ar { color: var(--t-hint); }
  .books a:hover .p { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr); gap: 0; } .tree { display: none; } .books { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) { .books a { grid-template-columns: minmax(0, 1fr) auto; } .books .w { display: none; } }
</style>
