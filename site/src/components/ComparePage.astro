---
/**
 * Shared template for every /vs/<competitor>/ page. Each competitor
 * page is a thin stub that imports this component:
 *
 *   import ComparePage from "@/components/ComparePage.astro";
 *   <ComparePage slug="tmux" />
 *
 * All content lives in `src/data/competitors.ts` — one edit there
 * updates all four pages.
 */
import Page from "@/layouts/Page.astro";
import Faq from "@/components/Faq.astro";
import {
  competitorMatrix,
  competitors,
  type CompetitorInfo,
  type Support,
  type VsRow,
} from "@/data/competitors";
import { breadcrumbSchema, faqSchema } from "@/data/schemas";

interface Props {
  slug: CompetitorInfo["slug"];
}

const { slug } = Astro.props;
const info = competitors[slug];

// "a" vs "an" for the "<name> alternative" head term in the meta
// description — only "Agent of Empires" is vowel-initial today, but the
// check keeps any future competitor grammatical.
const article = /^[aeiou]/i.test(info.name) ? "an" : "a";

const seo = {
  title: `Quil vs ${info.name}`,
  // The default stem already contains the brand, so the suffix would say
  // it twice and spend ~7 of the ~60 usable characters doing it.
  seoTitle: info.seoTitle,
  brandSuffix: false,
  description:
    info.seoDescription ??
    `Looking for ${article} ${info.name} alternative? Quil is a reboot-proof terminal multiplexer with AI session resume, typed panes, and an MCP server — see how it compares to ${info.name}.`,
  path: `/vs/${slug}/`,
  ogImage: `/og/vs-${slug}.png`,
  keywords: [
    `quil vs ${slug}`,
    `${slug} alternative`,
    `${slug} comparison`,
    "terminal multiplexer comparison",
    "persistent terminal",
  ],
};

const schemas = [
  breadcrumbSchema([
    { name: "Quil",   path: "/" },
    { name: "Compare", path: `/vs/${slug}/` },
    { name: info.name, path: `/vs/${slug}/` },
  ]),
  faqSchema(info.faq),
];

const otherCompetitors = (
  Object.keys(competitors) as CompetitorInfo["slug"][]
).filter((s) => s !== slug);

// Classic multiplexer pages share `competitorMatrix`; direct agent-orchestrator
// rivals (herdr / aoe) supply their own `info.matrix`. Normalize both into the
// same {feature, quil, them, note} shape so the table renders uniformly.
const classicSlugs = ["tmux", "zellij", "wezterm", "screen"] as const;
const rows: VsRow[] =
  info.matrix ??
  competitorMatrix.map((row) => ({
    feature: row.feature,
    quil: row.quil,
    them: row[slug as (typeof classicSlugs)[number]],
    note: row.note,
  }));

const quilHeadline =
  info.quilHeadline ?? "Reboot survival. AI continuity. Typed panes.";

interface CellGlyph {
  label: string;
  klass: "yes" | "no" | "partial";
}

function cellGlyph(support: Support): CellGlyph {
  if (support === "yes") return { label: "✓", klass: "yes" };
  if (support === "no")  return { label: "✕", klass: "no"  };
  return { label: "~", klass: "partial" };
}
---
<Page {...seo} schemas={schemas}>
  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Compare · <a href="/#compare">all comparisons</a></div>
      <h1>Quil vs {info.name}</h1>
      <p class="lede">{info.description}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="two">
        <div class="panel">
          <div class="eyebrow">{info.name} · where it wins</div>
          <h2>{info.keyStrength.split(".")[0]}.</h2>
          <p>{info.keyStrength}</p>
        </div>
        <div class="panel">
          <div class="eyebrow">Quil · where it takes over</div>
          <h2>{quilHeadline}</h2>
          <p>{info.keyGap}</p>
        </div>
      </div>
      <div class="fit">
        <div class="eyebrow">Where they fit</div>
        <p>{info.positioning}</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="eyebrow">Capability matrix</div>
      <h2>Feature by feature</h2>
      <div class="table-scroll">
        <table class="cmp">
          <thead><tr><th scope="col">capability</th><th scope="col">quil</th><th scope="col">{info.name}</th></tr></thead>
          <tbody>
            {rows.map((row) => {
              const q = cellGlyph(row.quil);
              const o = cellGlyph(row.them);
              return (
                <>
                  <tr>
                    <td>{row.feature}</td>
                    <td class="v"><b class={q.klass}><span aria-hidden="true">{q.label}</span><span class="sr-only">{q.klass}</span></b></td>
                    <td class="v"><b class={o.klass}><span aria-hidden="true">{o.label}</span><span class="sr-only">{o.klass}</span></b></td>
                  </tr>
                  {row.note && <tr class="note"><td colspan="3">└── {row.note}</td></tr>}
                </>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap narrow">
      <div class="eyebrow">Migrating from {info.name}</div>
      <h2>Coming from {info.name}?</h2>
      <p class="lede">{info.migrationNote}</p>
      <h2 class="faq-h">Questions</h2>
      <Faq items={info.faq} />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="eyebrow">See also</div>
      <h2>Other comparisons</h2>
      <ul class="others">
        {otherCompetitors.map((other) => <li><a href={`/vs/${other}/`}>Quil vs {competitors[other].name} →</a></li>)}
      </ul>
      <p class="cta"><a class="btn p" href="/#install">▸ install quil</a> <a class="btn" href="/#features">every capability →</a></p>
      <p class="side">Quil installs side by side with {info.name}. Nothing to uninstall first.</p>
    </div>
  </section>
</Page>

<style>
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .panel { border: 1px solid var(--t-line-2); padding: 20px 22px; }
  .panel h2 { font-size: clamp(20px, 2.2vw, 26px); }
  .panel p, .fit p { margin: 12px 0 0; color: var(--t-soft); }
  .fit { margin-top: 24px; padding: 18px 22px; background: var(--t-panel); border-left: 2px solid var(--t-dialog); }
  .table-scroll { margin-top: 22px; overflow-x: auto; }
  .cmp { width: 100%; border-collapse: collapse; font: 14px/1.5 var(--mono); }
  .cmp th { text-align: left; padding: 8px 10px; color: var(--t-mute); font-weight: 700; border-bottom: 1px solid var(--t-line-2); }
  .cmp th:not(:first-child), .cmp td.v { text-align: center; width: 7em; }
  .cmp td { padding: 9px 10px; border-bottom: 1px solid var(--t-line); color: var(--t-text); vertical-align: top; }
  .cmp b.yes { color: var(--t-ok); }
  .cmp b.no { color: var(--t-red); }
  .cmp b.partial { color: var(--t-amber); }
  .cmp tr.note td { padding-top: 0; color: var(--t-sub); font-size: 12px; font-style: italic; }
  .faq-h { margin-top: 40px; font-size: 22px; }
  .others { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font: 14px var(--mono); }
  .others a { color: var(--t-hint); }
  .others a:hover { color: var(--t-title); }
  .cta { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; }
  .side { color: var(--t-mute); font-size: 14px; }
  @media (max-width: 760px) { .two { grid-template-columns: minmax(0, 1fr); } }
</style>
