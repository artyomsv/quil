---
import { docHref, type ManualEntry } from "@/data/docs";
import { splitTicks } from "@/lib/ticks";

interface Props { e: ManualEntry; n: number }
const { e, n } = Astro.props;
// Lower-cased text the filter on /docs/ searches; built here so it matches what is shown.
const text = [e.persona, e.heading, ...e.steps, ...e.keys.flat(), ...e.read.map((r) => `${r.label} ${r.file}`)]
  .join(" ").replace(/`/g, "").toLowerCase();
---
<article class="entry" id={e.id} data-text={text}>
  <div class="idx">{String(n).padStart(2, "0")}</div>
  <div class="head">
    <span class="per">{e.persona}</span>
    {e.tour && <span class="see">see it in the <a href={`/#tour-${e.id}`}>tour</a></span>}
  </div>
  <h2>{e.heading}</h2>
  <div class="cols">
    <div class="col">
      <p class="ch">DO</p>
      <ol>{e.steps.map((s) => <li><span>{splitTicks(s).map((p, i) => (i % 2 ? <code>{p}</code> : p))}</span></li>)}</ol>
    </div>
    <div class="col">
      <p class="ch">KEYS</p>
      <div class="keys2">{e.keys.map(([k, what]) => <div class="k"><kbd>{k}</kbd>{what && <span>{what}</span>}</div>)}</div>
    </div>
    <div class="col">
      <p class="ch">READ ON GITHUB</p>
      <div class="reads">
        {e.read.map((r) => (
          <a href={docHref(r)} rel="noopener"><span><span class="f">{r.file.replace("docs/", "")} ›</span> <span class="s">{r.label}</span></span><span class="ar">↗</span></a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .entry { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 0 18px; padding-block: 26px 28px; border-top: 1px solid var(--t-line); scroll-margin-top: calc(var(--hh) + 16px); }
  .entry:target { animation: flash 1.6s ease-out 1; }
  @keyframes flash { 0% { background: #5f00ff24; } 100% { background: transparent; } }
  .idx { font: 800 26px/1 var(--mono); color: var(--t-hint); padding-top: 2px; font-variant-numeric: tabular-nums; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px; align-items: baseline; }
  .per { font: 700 11.5px var(--mono); letter-spacing: .18em; color: var(--t-mute); }
  .see { font: 12px var(--mono); color: var(--t-dim); }
  .see a { color: var(--t-title); background: var(--t-line-2); padding: 0 .8ch; }
  .see a:hover { background: var(--t-violet); }
  h2 { grid-column: 2; margin: 8px 0 0; font: 800 clamp(19px, 1.8vw, 24px)/1.25 var(--mono); letter-spacing: -0.015em; color: var(--t-title); max-width: 46ch; text-wrap: balance; }
  .cols { grid-column: 2; margin-top: 18px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .8fr) minmax(0, 1.15fr); border: 1px solid var(--t-line-2); border-radius: 6px; overflow: hidden; }
  .col { padding: 13px 16px 15px; min-width: 0; }
  .col + .col { border-left: 1px solid var(--t-line-2); }
  .ch { margin: 0 0 10px; font: 700 10.5px var(--mono); letter-spacing: .2em; color: var(--t-sub); }
  ol { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 9px; }
  ol li { counter-increment: s; display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; font-size: 14px; line-height: 1.5; color: var(--t-text); }
  ol li::before { content: counter(s); font: 700 12px/1.75 var(--mono); color: var(--t-hint); }
  /* A command wraps inside its own column, never under the next one: the
     columns stay narrow at every width because the page width is capped. */
  code { font: 12.5px var(--mono); color: var(--t-title); background: var(--t-line); padding: 0 5px; overflow-wrap: anywhere; }
  .keys2 { display: grid; gap: 8px; }
  .k { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font: 12.5px var(--mono); color: var(--t-mute); }
  kbd { font: 700 12px var(--mono); color: #080808; background: var(--t-title); padding: 1px 7px; border-radius: 3px; box-shadow: 0 2px 0 #9e9e7a; max-width: 100%; overflow-wrap: anywhere; }
  .reads { display: grid; gap: 6px; }
  .reads a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: baseline; font: 12.5px/1.45 var(--mono); color: var(--t-soft); padding: 3px 0; border-bottom: 1px dashed var(--t-line-2); }
  .reads a:last-child { border-bottom: 0; }
  .f { color: var(--t-sub); }
  .s { color: var(--t-title); }
  .ar { color: var(--t-hint); }
  .reads a:hover .s { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 980px) { .cols { grid-template-columns: minmax(0, 1fr); } .col + .col { border-left: 0; border-top: 1px solid var(--t-line-2); } }
  @media (max-width: 600px) { .entry { grid-template-columns: minmax(0, 1fr); } .idx { font-size: 20px; margin-bottom: 8px; } h2, .cols { grid-column: 1; } }
  @media (prefers-reduced-motion: reduce) { .entry:target { animation: none; } }
</style>
