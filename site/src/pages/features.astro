---
/**
 * Features — the full catalogue.
 *
 * Content is sourced from `data/features.ts`; this file only handles
 * layout + SEO. The page auto-keeps up with the data layer — add a
 * new entry with a valid category and it shows up in the right
 * section with no markup edits.
 */
import Page from "@/layouts/Page.astro";
import { SITE } from "@/data/seo";
import { breadcrumbSchema, itemListSchema } from "@/data/schemas";
import { features, featureCategories, type Feature } from "@/data/features";

const seo = {
  title: "Features — remote attach, command palette, AI resume, typed panes",
  description:
    "Every Quil capability: reboot-proof persistence, remote attach over SSH, a command palette that searches every pane, AI session auto-resume, typed panes, MCP server, and TOML plugins.",
  path: "/features",
  ogImage: "/og/features.png",
  keywords: [
    "quil features",
    "terminal multiplexer features",
    "persistent terminal",
    "tmux alternative features",
    "ai session resume",
    "remote terminal multiplexer",
    "ssh remote attach",
    "terminal command palette",
    "search terminal scrollback",
  ],
};

const schemas = [
  breadcrumbSchema([
    { name: "Quil",     path: "/" },
    { name: "Features", path: "/features" },
  ]),
  itemListSchema({
    name: "Quil features",
    description: `The complete list of Quil capabilities in v${SITE.software.version}: persistence, AI integration, interaction, extensibility, and observability.`,
    url: SITE.url + "/features",
    items: features.map((f) => ({
      name: f.title,
      description: f.blurb,
      url: SITE.url + "/features#" + f.slug,
    })),
  }),
];

const categoryOrder: Feature["category"][] = [
  "persistence",
  "ai",
  "interaction",
  "extensibility",
  "observability",
];

const byCategory: Record<Feature["category"], Feature[]> = {
  persistence:   [],
  ai:            [],
  interaction:   [],
  extensibility: [],
  observability: [],
};
for (const feature of features) {
  byCategory[feature.category].push(feature);
}
---
<Page {...seo} schemas={schemas}>
  <section class="page-hero">
    <div class="container-ember stack">
      <div class="hero-ruler">
        <span>§ FEATURES · {features.length} CAPABILITIES</span>
        <span>CAT <b>{categoryOrder.length}</b></span>
        <span style="margin-left:auto;">scroll for the full catalog ↓</span>
      </div>
      <span class="eyebrow">THE FULL CATALOG</span>
      <h1>Every capability. No fluff.</h1>
      <p>
        {features.length} features across {categoryOrder.length} categories. Each one earns
        its place, each one is load-bearing in a real developer's day.
        If you came here looking for a matrix of checkboxes — this is
        the matrix.
      </p>

      {/* Jump nav. Without it this page is a single 29-item scroll with no
          index, so a feature that exists reads as a feature that is missing —
          which is exactly the report that prompted adding this. Every entry
          is a real anchor into the sections below. */}
      <nav class="feat-jump" aria-label="Jump to a feature category">
        {categoryOrder.map((cat) => (
          <a href={`#cat-${cat}`}>
            {featureCategories[cat]}
            <span class="n">{byCategory[cat].length}</span>
          </a>
        ))}
      </nav>

      <div class="feat-jump-hint">
        Most asked for: <a href="#remote-daemon-ssh">Remote daemon over SSH</a> ·
        <a href="#command-palette">Command palette + content search</a> ·
        <a href="#ai-session-resume">AI session resume</a> ·
        <a href="#mcp-server">MCP server</a>
      </div>
    </div>
  </section>

  {categoryOrder.map((cat, index) => {
    const items = byCategory[cat];
    if (items.length === 0) return null;
    const sectionNo = String(index + 1).padStart(2, "0");
    return (
      <section class="feat-category" id={`cat-${cat}`}>
        <div class="container-ember stack">
          <div class="feat-category-head">
            <div>
              <span class="eyebrow">§ {sectionNo} / {String(categoryOrder.length).padStart(2, "0")}</span>
              <h2 style="margin-top:10px;">{featureCategories[cat]}</h2>
            </div>
            <span class="count">{items.length} {items.length === 1 ? "FEATURE" : "FEATURES"}</span>
          </div>

          <div class="feat-list">
            {items.map((feature, featureIdx) => (
              <div class="feat-item" id={feature.slug}>
                <span class="idx">[{sectionNo}.{String(featureIdx + 1).padStart(2, "0")}]</span>
                <div>
                  <h3>
                    {feature.title}
                    {feature.badge && <span class="feat-badge">{feature.badge}</span>}
                  </h3>
                  <p class="blurb">{feature.blurb}</p>
                  <ul>
                    {feature.detail.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                  {feature.image && (
                    <img
                      class="feat-shot"
                      src={feature.image}
                      alt={`${feature.title} — Quil screenshot`}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="cta" style="padding: 80px 0;">
    <div class="container-ember stack">
      <div class="cta-inner">
        <h2 style="font-size: clamp(32px, 4.5vw, 56px);">Ready?</h2>
        <p>
          No account, no signup, no telemetry. <code style="color:var(--flame);">curl | sh</code>
          and you're in.
        </p>
        <div class="actions">
          <a href="/install" class="btn btn-primary">▸ install quil</a>
          <a href="/" class="btn btn-outline">← back home</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  /* Category jump nav + "most asked for" shortcut row. */
  .feat-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .feat-jump a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
    color: var(--ink-2);
    font-family: var(--mono-stack);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .feat-jump a:hover,
  .feat-jump a:focus-visible {
    border-color: var(--flame);
    color: var(--ink);
  }
  .feat-jump .n {
    color: var(--ink-4);
    font-size: 11px;
  }

  .feat-jump-hint {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.9;
    color: var(--ink-3);
  }
  .feat-jump-hint a {
    color: var(--flame);
    text-decoration: none;
  }
  .feat-jump-hint a:hover {
    text-decoration: underline;
  }

  /* Anchor targets sit under no fixed header, but a little breathing room
     keeps the heading off the very top edge when jumped to. */
  .feat-category,
  .feat-item {
    scroll-margin-top: 24px;
  }

  /* Feature screenshots (opt-in via the data layer's `image` field). */
  .feat-shot {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin-top: 18px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
