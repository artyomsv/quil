---
/**
 * The site header, drawn the way Quil draws its own tab bar: number, colon,
 * name, and the current page marked "*" on a violet tab. The tour runtime
 * measures `header.hdr` to place the pinned terminal — keep the class.
 *
 * Every internal href keeps its trailing slash (scripts/check-trailing-slash.mjs).
 */
import { SITE } from "@/data/seo";

const tabs = [
  { href: "/", label: "tour", on: (p: string) => p === "/" },
  { href: "/#install", label: "install", on: () => false },
  { href: "/docs/", label: "docs", on: (p: string) => p.startsWith("/docs/") },
  { href: "/blog/", label: "blog", on: (p: string) => p.startsWith("/blog/") },
  { href: "/#compare", label: "compare", on: (p: string) => p.startsWith("/vs/") },
];
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<header class="hdr">
  <a class="brand" href="/" aria-label="Quil home">
    <img src="/brand/mark.svg" alt="" width="16" height="18" />
    quil
  </a>
  <nav aria-label="Main">
    {tabs.map((t, i) => {
      const on = t.on(path);
      return <a href={t.href} aria-current={on ? "page" : undefined}>{on ? "* " : ""}{i + 1}:{t.label}</a>;
    })}
  </nav>
  <div class="r">
    <span class="v">v<b>{SITE.software.version}</b></span>
    <a href={SITE.github} rel="noopener">github</a>
  </div>
</header>
