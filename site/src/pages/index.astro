---
/**
 * Home page. The guided tour comes first (TourStage); the sections below are
 * the same story for readers and crawlers (spec Part C).
 *
 * FAQPage JSON-LD and the visible FAQ come from the one `homeFaq` array —
 * Google honours FAQ structured data only when the same text is visible.
 */
import Page from "@/layouts/Page.astro";
import Faq from "@/components/Faq.astro";
import UseCases from "@/components/home/UseCases.astro";
import Install from "@/components/home/Install.astro";
import Features from "@/components/home/Features.astro";
import Compare from "@/components/home/Compare.astro";
import TourStage from "@/components/home/TourStage.astro";
import AfterTour from "@/components/home/AfterTour.astro";
import "@/styles/tour.css";
import { softwareApplicationSchema, faqSchema } from "@/data/schemas";
import { homeFaq } from "@/data/faq";

// Title and description are unchanged from the previous design (spec §C.2):
// brand first, because "quil" brings most of the impressions.
const seo = {
  title: "Reboot-proof terminal multiplexer for AI development",
  seoTitle: "Quil — the reboot-proof terminal multiplexer for AI coding agents",
  brandSuffix: false,
  description:
    "Quil is a reboot-proof terminal multiplexer for AI-native developers. Typed panes, auto-resuming Claude Code sessions, remote attach over SSH, and an MCP server. One static binary per platform.",
  path: "/",
  ogImage: "/og/home.png",
  keywords: [
    "quil", "terminal multiplexer", "persistent terminal", "tmux alternative", "ai terminal",
    "claude code multiplexer", "reboot-proof workflow", "mcp server", "remote terminal multiplexer",
    "ssh remote attach", "terminal command palette",
  ],
};

const schemas = [softwareApplicationSchema(), faqSchema(homeFaq)];
---
<Page {...seo} schemas={schemas}>
  <TourStage />
  <AfterTour />
  <UseCases />
  <Install />
  <Features />
  <section class="sec" id="faq" aria-labelledby="faq-h">
    <div class="wrap narrow">
      <div class="eyebrow">FAQ</div>
      <h2 id="faq-h">Questions people ask</h2>
      <Faq items={homeFaq} />
    </div>
  </section>
  <Compare />
</Page>
