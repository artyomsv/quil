---
/**
 * 404 — GitHub Pages serves dist/404.html for unmatched paths. noindex, and
 * therefore no canonical (BaseHead).
 */
import Page from "@/layouts/Page.astro";

const seo = {
  title: "Page not found",
  description: "That pane was not restored. The page you asked for is not on quil.cc; the tour, the docs and the install steps are one click away.",
  path: "/404",
  robots: "noindex",
};
---
<Page {...seo}>
  <section class="sec">
    <div class="wrap nf">
      <pre aria-hidden="true">┌──────────────────────────────┐
│                              │
│      ▲  PANE NOT RESTORED     │
│                              │
└──────────────────────────────┘</pre>
      <h1>That pane was not restored.</h1>
      <p class="lede">The page you asked for is not here. It may have moved when the site got smaller.</p>
      <p class="nf-acts"><a class="btn p" href="/">▸ take the tour</a> <a class="btn" href="/docs/">docs</a> <a class="btn" href="/#install">install</a></p>
    </div>
  </section>
</Page>

<style>
  .nf { padding-block: 40px 60px; }
  pre { margin: 0; color: var(--t-amber); font-size: 14px; line-height: 1.3; overflow-x: auto; }
  h1 { margin: 24px 0 0; font: 800 clamp(30px, 4.6vw, 52px)/1.1 var(--mono); color: var(--t-title); }
  .nf-acts { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; }
</style>
