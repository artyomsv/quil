---
// Base layout for every page: the HTML shell, site-wide JSON-LD
// (Organization + WebSite), the per-page head, header and footer.
import "@/styles/tokens.css";
import "@/styles/site.css";
import BaseHead from "@/components/BaseHead.astro";
import JsonLd from "@/components/JsonLd.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { organizationSchema, websiteSchema } from "@/data/schemas";
import { SITE, type Page } from "@/data/seo";

interface Props extends Page {
  /** Extra JSON-LD documents for this page. */
  schemas?: Record<string, unknown>[];
}

// Everything except `schemas` is a BaseHead concern and is forwarded as is,
// so a new optional field on `Page` reaches <head> without an edit here.
const { schemas = [], ...page } = Astro.props;
const sitewideSchemas = [organizationSchema(), websiteSchema(), ...schemas];
---
<!doctype html>
<html lang={SITE.htmlLang}>
  <head>
    <BaseHead {...page} />
    <JsonLd data={sitewideSchemas} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
