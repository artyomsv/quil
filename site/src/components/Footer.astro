---
/**
 * Site footer: four link columns over a status line. Every kept page is
 * linked from here on every page. The hidden rel="me" links cross-verify the
 * author's profiles for IndieAuth/fediverse; they are for machines only.
 */
import { SITE, GITHUB_BLOB } from "@/data/seo";
import { compareNav } from "@/data/competitors";

interface FooterLink { href: string; text: string }
const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: "Product",
    links: [
      { href: "/", text: "Tour" },
      { href: "/#install", text: "Install" },
      { href: "/#features", text: "Features" },
      { href: "/#plugins", text: "Pane types" },
      { href: "/docs/", text: "Docs" },
      { href: "/blog/", text: "Blog" },
    ],
  },
  { title: "Compare", links: compareNav.map(({ href, label }) => ({ href, text: label })) },
  {
    title: "Read on GitHub",
    links: [
      { href: `${GITHUB_BLOB}README.md`, text: "README" },
      { href: `${GITHUB_BLOB}docs/mcp.md`, text: "MCP server" },
      { href: `${GITHUB_BLOB}docs/workspace-templates.md`, text: "Templates" },
      { href: `${GITHUB_BLOB}docs/sandbox-panes.md`, text: "Sandbox panes" },
      { href: `${GITHUB_BLOB}docs/keybindings.md`, text: "Keybindings" },
      { href: `${GITHUB_BLOB}CHANGELOG.md`, text: "Changelog" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: SITE.github, text: "GitHub" },
      { href: `${SITE.github}/issues`, text: "Issues" },
      { href: `${SITE.github}/releases/latest`, text: "Releases" },
      { href: "/legal/", text: "Legal" },
      { href: "/rss.xml", text: "RSS" },
      { href: "/llms.txt", text: "llms.txt" },
    ],
  },
];
const external = (href: string) => href.startsWith("http");
---
<footer class="site-foot">
  <div class="cols">
    {columns.map((c) => (
      <nav aria-label={c.title}>
        <h2>{c.title}</h2>
        <ul>
          {c.links.map((l) => <li><a href={l.href} rel={external(l.href) ? "noopener" : undefined}>{l.text}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="status">
    <span>~/quil.cc · Apache-2.0 · Linux · macOS · Windows</span>
    <span>© {new Date().getFullYear()} {SITE.name} · v{SITE.software.version}</span>
  </div>
  <div class="sr-only" aria-hidden="true">
    <a rel="me" href={SITE.author.url} tabindex="-1">{SITE.author.name} on GitHub</a>
    <a rel="me" href={SITE.github} tabindex="-1">Quil repository</a>
  </div>
</footer>
